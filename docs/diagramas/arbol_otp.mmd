flowchart TD
    %% ARBOL DE SUPERVISION OTP DEL SISTEMA DE EMERGENCIAS

    SupervisorRaiz["SupervisorRaiz\n(Supervisor :one_for_one\nmax_restarts: 3, max_seconds: 5)"]

    Reg["RegistroAlbergues\n(Registry :unique)"]
    Bitacora["Bitacora\n(Proceso puro con receive)"]
    GUsr["GestorUsuarios\n(GenServer : PuertoUsuarios)"]
    GZon["GestorZonas\n(GenServer : PuertoZonas)"]
    GLog["GestorLogistica\n(GenServer : PuertoLogistica\nSerializador atomico: recursos, necesidades, movimientos)"]
    GPer["GestorPersonas\n(GenServer : PuertoPersonas)"]
    GMas["GestorMascotas\n(GenServer : PuertoMascotas)"]
    SupAlb["SupervisorAlbergues\n(DynamicSupervisor :one_for_one\nImplementa PuertoAlbergues)"]
    TaskSup["Emergencias.TaskSupervisor\n(Task.Supervisor Tareas Paralelas)"]

    %% Procesos dinamicos bajo SupervisorAlbergues
    Alb1["Albergue ALB001\n(Proceso puro con bucle receive)"]
    Alb2["Albergue ALB002\n(Proceso puro con bucle receive)"]
    AlbN["Albergue ALB...\n(Proceso puro con bucle receive)"]

    %% Conexiones del arbol de supervision
    SupervisorRaiz --> Reg
    SupervisorRaiz --> Bitacora
    SupervisorRaiz --> GUsr
    SupervisorRaiz --> GZon
    SupervisorRaiz --> GLog
    SupervisorRaiz --> GPer
    SupervisorRaiz --> GMas
    SupervisorRaiz --> SupAlb
    SupervisorRaiz --> TaskSup

    %% Supervision Dinamica de Albergues
    SupAlb -. supervisa dinamicamente .-> Alb1
    SupAlb -. supervisa dinamicamente .-> Alb2
    SupAlb -. supervisa dinamicamente .-> AlbN

    %% Registro de Albergues
    Alb1 -. registrado en .-> Reg
    Alb2 -. registrado en .-> Reg
    AlbN -. registrado en .-> Reg
