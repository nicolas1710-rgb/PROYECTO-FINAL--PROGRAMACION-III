sequenceDiagram
    autonumber
    %% FLUJO CONCURRENTE Y ATÓMICO: ASIGNACIÓN DE RECURSOS A NECESIDADES

    actor Laura as Coordinadora (Laura)
    actor Carlos as Coordinador Auxiliar (Carlos)
    participant Desp as DespachadorComandos
    participant CU as GestionarRecursos (Caso de Uso)
    participant PS_Nec as PuertoSalidaNecesidades (GestorNecesidades)
    participant PS_Rec as PuertoSalidaRecursos (GestorRecursos OTP)
    participant Reglas as Inventario / Transiciones (Dominio Puro)
    participant MP as MotorPersistencia (GenServer Escritura)

    Note over PS_Rec: Estado Inicial: R001 tiene 50 L disponibles en inventario
    Note over PS_Nec: Estado Inicial: N001 pide 30 L (pendiente), N002 pide 25 L (pendiente)

    par Solicitudes Concurrentes (Task.async_stream)
        Laura->>Desp: assign_resource("R001", "N001", 30)
        Desp->>CU: asignar_recurso("R001", "N001", 30, Laura)
    and
        Carlos->>Desp: assign_resource("R001", "N002", 25)
        Desp->>CU: asignar_recurso("R001", "N002", 25, Carlos)
    end

    Note over CU, PS_Nec: 1. Validación de Necesidad: abierta y cantidad no excede lo pendiente
    CU->>PS_Nec: consultar("N001")
    PS_Nec-->>CU: {:ok, N001_pendiente_30}

    Note over PS_Rec: El buzón de mensajes del GenServer serializa el acceso al stock

    %% Tramitación de la petición de Laura (30 L)
    rect rgb(240, 255, 240)
        Note over CU, PS_Rec: 2. Descuento atómico de Stock para Laura (30 L)
        CU->>PS_Rec: asignar("R001", "N001", 30, Laura)
        PS_Rec->>Reglas: Inventario.asignar(R001, 30, ...)
        Reglas-->>PS_Rec: {:ok, {R001_disp_20, MOV001}}
        PS_Rec->>MP: guardar(:recursos, R001_disp_20)
        PS_Rec->>MP: anexar(:movimientos, MOV001)
        PS_Rec-->>CU: {:ok, {R001_disp_20, MOV001}}

        Note over CU, PS_Nec: 3. Actualización de Necesidad N001 (cantidad_asignada = 30 -> :atendida)
        CU->>PS_Nec: asignar_suministro("N001", 30, Laura)
        PS_Nec-->>CU: {:ok, N001_atendida}
        CU-->>Desp: {:ok, R001_actualizado}
        Desp-->>Laura: [OK] Asignados 30 litros de [R001] a [N001]. Stock restante: 20
    end

    %% Tramitación concurrente de la petición de Carlos (25 L)
    rect rgb(255, 240, 240)
        Note over CU, PS_Rec: 4. Descuento atómico de Stock para Carlos (25 L)
        CU->>PS_Nec: consultar("N002")
        PS_Nec-->>CU: {:ok, N002_pendiente_25}
        CU->>PS_Rec: asignar("R001", "N002", 25, Carlos)
        PS_Rec->>Reglas: Inventario.asignar(R001, 25, ...)
        Note over Reglas: Validación de Saldo: disponible (20) < solicitado (25)
        Reglas-->>PS_Rec: {:error, :stock_insuficiente}
        PS_Rec-->>CU: {:error, :stock_insuficiente}
        CU-->>Desp: {:error, :stock_insuficiente}
        Desp-->>Carlos: [ERROR] Existencias insuficientes en inventario para atender la solicitud.
    end
