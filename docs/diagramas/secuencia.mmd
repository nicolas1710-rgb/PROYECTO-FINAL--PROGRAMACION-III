sequenceDiagram
    autonumber
    %% FLUJO CONCURRENTE Y ATOMICO: ASIGNACION EN GESTORLOGISTICA

    actor Laura as Coordinadora (Laura)
    actor Carlos as Coordinador Auxiliar (Carlos)
    participant Desp as Despachador
    participant CU as GestionarLogistica (Caso de Uso)
    participant GLog as GestorLogistica (GenServer FIFO)
    participant Asig as Asignacion (Dominio Puro)
    participant Archivo as AlmacenArchivo (.txt)

    Note over GLog: Estado Inicial: R001 (50 L disponibles)<br/>N001 pide 30 L (pendiente)<br/>N002 pide 25 L (pendiente)

    par Solicitudes Concurrentes (Task.async_stream)
        Laura->>Desp: assign_resource("R001", "N001", 30)
        Desp->>CU: asignar_recurso("R001", "N001", 30, Laura)
        CU->>GLog: asignar("R001", "N001", 30, "Laura")
    and
        Carlos->>Desp: assign_resource("R001", "N002", 25)
        Desp->>CU: asignar_recurso("R001", "N002", 25, Carlos)
        CU->>GLog: asignar("R001", "N002", 25, "Carlos")
    end

    Note over GLog: El buzon FIFO serializa las solicitudes.<br/>Laura se atiende primero.

    %% Tramitacion de la peticion de Laura (30 L)
    rect rgb(240, 255, 240)
        Note over GLog, Asig: 1. Ejecucion atomica de Asignacion.asignar/6
        GLog->>Asig: asignar(recursos, necesidades, "R001", "N001", 30, "Laura")
        Note over Asig: Valida necesidad (abierta, saldo pendiente 30 >= 30)<br/>Valida stock recurso (50 >= 30)<br/>Actualiza N001 a :atendida y R001 a 20 L disp.
        Asig-->>GLog: {:ok, {nuevo_r, nuevo_n, mov, nuevo_estado}}
        GLog->>Archivo: persistir(:recursos, :necesidades, :movimientos)
        GLog-->>CU: {:ok, {nuevo_r, nuevo_n, mov}}
        CU-->>Desp: {:ok, {nuevo_r, nuevo_n, mov}}
        Desp-->>Laura: [EXITO] Asignados 30 de [R001] a [N001]. Stock restante: 20.
    end

    %% Tramitacion concurrente de la peticion de Carlos (25 L)
    rect rgb(255, 240, 240)
        Note over GLog, Asig: 2. Siguiente mensaje en buzon FIFO: Peticion de Carlos
        GLog->>Asig: asignar(recursos, necesidades, "R001", "N002", 25, "Carlos")
        Note over Asig: Stock disponible en R001 es 20 L < 25 L solicitados
        Asig-->>GLog: {:error, :stock_insuficiente}
        Note over GLog: El estado no se muta (cero rollback, cero compensacion)
        GLog-->>CU: {:error, :stock_insuficiente}
        CU-->>Desp: {:error, :stock_insuficiente}
        Desp-->>Carlos: [ERROR] Existencias insuficientes en inventario para atender la solicitud.
    end
