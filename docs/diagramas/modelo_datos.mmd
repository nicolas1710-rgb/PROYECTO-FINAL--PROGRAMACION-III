classDiagram
    %% MODELO DE DATOS Y RELACIONES DEL SISTEMA DE EMERGENCIAS

    class Usuario {
        +String id
        +String nombre
        +Atom rol
        +String clave_hash
    }

    class Zona {
        +String id
        +String nombre
        +Atom nivel_gravedad
        +Integer personas_afectadas
        +List~Sector~ sectores
    }

    class Sector {
        +String id
        +String nombre
        +Integer personas_afectadas
        +List~PuntoAtencion~ puntos_atencion
    }

    class PuntoAtencion {
        +String id
        +String nombre
        +Integer personas_afectadas
    }

    class Necesidad {
        +String id
        +String codigo_zona
        +String tipo_recurso
        +String descripcion
        +Integer cantidad_solicitada
        +Integer cantidad_asignada
        +Atom prioridad
        +Atom estado
        +String responsable
    }

    class Recurso {
        +String id
        +String nombre
        +String categoria
        +Integer cantidad_disponible
        +Integer cantidad_total
        +String unidad_medida
        +String ubicacion
    }

    class Movimiento {
        +String id
        +String recurso_id
        +Atom tipo
        +Integer cantidad
        +String origen
        +String destino
        +String fecha
    }

    class Persona {
        +String documento
        +String nombre
        +Integer edad
        +String zona
        +Atom estado
        +String codigo_albergue
    }

    class Mensaje {
        +String id
        +String documento
        +String remitente
        +String contenido
        +String fecha
    }

    class Mascota {
        +String id
        +Atom tipo_reporte
        +String especie
        +String color
        +Atom tamano
        +String codigo_zona
        +String nombre
        +List rasgos
        +Atom estado
    }

    class Albergue {
        +String id
        +String nombre
        +String codigo_zona
        +Integer capacidad_maxima
        +MapSet personas_alojadas
        +List recursos_asignados
        +List necesidades_asociadas
    }

    %% Jerarquia y Relaciones
    Zona "1" *-- "many" Sector : contiene
    Sector "1" *-- "many" PuntoAtencion : agrupa
    Zona "1" <-- "many" Necesidad : reportada_en
    Zona "1" <-- "many" Recurso : almacenado_en
    Recurso "1" <-- "many" Movimiento : registra_historial
    Persona "1" <-- "many" Mensaje : recibe
    Zona "1" <-- "many" Albergue : ubicado_en
    Albergue "1" o-- "many" Persona : aloja_documentos
    Albergue "1" ..> "many" Recurso : vincula_recursos
    Albergue "1" ..> "many" Necesidad : vincula_necesidades
    Zona "1" <-- "many" Mascota : perdida_o_hallada_en
