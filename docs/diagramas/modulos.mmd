flowchart TD
    %% ARQUITECTURA HEXAGONAL ESTRICTA DEL SISTEMA DE EMERGENCIAS
    subgraph Infraestructura_Entrada["INFRAESTRUCTURA - ADAPTADORES DE ENTRADA"]
        Consola["Consola CLI (priv/main.exs)"]
        Analizador["AnalizadorComandos"]
        Despachador["DespachadorComandos"]
        Presentador["Presentador (Formateador Español)"]
    end

    subgraph Aplicacion_Capa["APLICACIÓN - CASOS DE USO Y PUERTOS"]
        subgraph Puertos_Entrada["Puertos de Entrada (Behaviours)"]
            PE_Usr["PuertoUsuarios"]
            PE_Zon["PuertoZonas"]
            PE_Nec["PuertoNecesidades"]
            PE_Rec["PuertoRecursos"]
            PE_Fam["PuertoFamiliares"]
            PE_Mas["PuertoMascotas"]
            PE_Alb["PuertoAlbergues"]
            PE_Res["PuertoResumenes"]
        end

        subgraph Casos_Uso["Casos de Uso (Orquestadores)"]
            CU_Usr["GestionarUsuarios"]
            CU_Zon["GestionarZonas"]
            CU_Nec["GestionarNecesidades"]
            CU_Rec["GestionarRecursos"]
            CU_Fam["GestionarFamiliares"]
            CU_Mas["GestionarMascotas"]
            CU_Alb["GestionarAlbergues"]
            CU_Res["GenerarResumenes"]
        end

        subgraph Puertos_Salida["Puertos de Salida (Behaviours Especializados)"]
            PS_Usr["PuertoSalidaUsuarios"]
            PS_Zon["PuertoSalidaZonas"]
            PS_Nec["PuertoSalidaNecesidades"]
            PS_Rec["PuertoSalidaRecursos"]
            PS_Per["PuertoSalidaPersonas"]
            PS_Mas["PuertoSalidaMascotas"]
            PS_Alb["PuertoSalidaAlbergues"]
            PS_Bit["Bitacora"]
            PS_Reloj["Reloj"]
            PS_GenId["GeneradorId"]
