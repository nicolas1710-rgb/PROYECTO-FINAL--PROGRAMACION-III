        end
    end

    subgraph Dominio_Nucleo["DOMINIO PURO - NÚCLEO INMUTABLE (Sin IO, Sin Procesos)"]
        subgraph Modelos["Modelos (Structs con Enforce Keys)"]
            M_Usuario["Usuario"]
            M_Zona["Zona"]
            M_Sector["Sector"]
            M_Punto["PuntoAtencion"]
            M_Necesidad["Necesidad"]
            M_Recurso["Recurso"]
            M_Movimiento["MovimientoInventario"]
            M_Persona["Persona"]
            M_Mensaje["Mensaje"]
            M_Mascota["ReporteMascota"]
            M_Albergue["Albergue"]
            M_Actividad["RegistroActividad"]
        end

        subgraph Reglas["Reglas Puras y Algoritmos"]
            R_Val["Validaciones"]
            R_Trans["TransicionesEstado"]
            R_Perm["Permisos (RBAC MapSet)"]
            R_Prio["Prioridades"]
            R_Ord["Ordenamiento (Merge Sort Recursivo)"]
            R_Inv["Inventario (Atomicidad de Stock)"]
            R_Ocup["Ocupacion (Cupos y Aforo)"]
            R_Sim["SimilitudMascotas (Ponderado Jaccard)"]
            R_Est["EstadisticasZona (Recursión Pura)"]
        end
    end

    subgraph Infraestructura_Salida["INFRAESTRUCTURA - ADAPTADORES DE SALIDA Y PROCESOS OTP"]
        subgraph Concurrencia_OTP["Procesos OTP y Adaptadores"]
            G_Usr["GestorUsuarios\n(implementa PuertoSalidaUsuarios)"]
            G_Zon["GestorZonas\n(implementa PuertoSalidaZonas)"]
            G_Nec["GestorNecesidades\n(implementa PuertoSalidaNecesidades)"]
            G_Rec["GestorRecursos\n(implementa PuertoSalidaRecursos)"]
            G_Per["GestorPersonas\n(implementa PuertoSalidaPersonas)"]
            G_Mas["GestorMascotas\n(implementa PuertoSalidaMascotas)"]
            A_Alb["AdaptadorAlbergues\n(implementa PuertoSalidaAlbergues)"]
            Sup_Alb["SupervisorAlbergues\n(DynamicSupervisor)"]
            P_Alb["Albergue\n(Proceso Puro con bucle receive)"]
            P_Bit["BitacoraActividad\n(Proceso Puro con bucle receive)"]
        end

        subgraph Persistencia_Archivos["Persistencia en Disco (.txt)"]
            MotorPers["MotorPersistencia (GenServer Escritor Atómico)"]
            Codif["CodificadorTexto (Formato Pipe Seguro)"]
            Almacen["AlmacenArchivo (implementa Repositorio)"]
        end
    end

    %% Relaciones entre capas (Hacia adentro estrictamente)
    Consola --> Analizador
    Analizador --> Despachador
    Despachador --> Casos_Uso
    Despachador --> Presentador

    Casos_Uso --> Reglas
    Casos_Uso --> Modelos
    Casos_Uso --> Puertos_Salida

    %% Implementaciones de Puertos de Salida
    G_Usr -. implementa .-> PS_Usr
    G_Zon -. implementa .-> PS_Zon
    G_Nec -. implementa .-> PS_Nec
    G_Rec -. implementa .-> PS_Rec
    G_Per -. implementa .-> PS_Per
    G_Mas -. implementa .-> PS_Mas
    A_Alb -. implementa .-> PS_Alb
    P_Bit -. implementa .-> PS_Bit
    Almacen -. implementa .-> PS_Repo

    %% Infraestructura interna
    A_Alb --> Sup_Alb
    A_Alb --> MotorPers
    Sup_Alb -. supervisa .-> P_Alb
    Concurrencia_OTP --> MotorPers
    Concurrencia_OTP --> Reglas
    MotorPers --> Codif
