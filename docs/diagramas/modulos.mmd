flowchart TD
    %% ARQUITECTURA HEXAGONAL ESTRICTA DEL SISTEMA DE EMERGENCIAS
    subgraph Adaptadores_Entrada["INFRAESTRUCTURA - ADAPTADORES DE ENTRADA"]
        subgraph Entrada_Consola["Entrada Consola CLI"]
            Consola["Consola CLI (priv/main.exs)"]
            Analizador["Analizador"]
            Despachador["Despachador"]
            Presentador["Presentador"]
        end

        subgraph Entrada_Web["Entrada Web (Phoenix LiveView)"]
            Endpoint["Endpoint & Router"]
            SesionCtrl["SesionController"]
            LiveViews["LiveViews (Resumen, Logistica, Zonas, Familiares, Mascotas, Albergues)"]
            NotifWeb["Notificador (difunde tras éxito)"]
        end
    end

    subgraph Aplicacion_Capa["APLICACION - CASOS DE USO Y PUERTOS"]
        subgraph Casos_Uso["Casos de Uso (Orquestadores Puros)"]
            CU_Usr["GestionarUsuarios"]
            CU_Zon["GestionarZonas"]
            CU_Log["GestionarLogistica"]
            CU_Fam["GestionarFamiliares"]
            CU_Mas["GestionarMascotas"]
            CU_Alb["GestionarAlbergues"]
            CU_Res["GenerarResumenes"]
        end

        subgraph Puertos_Salida["Puertos de Salida (Behaviours Inyectados)"]
            PS_Usr["PuertoUsuarios"]
            PS_Zon["PuertoZonas"]
            PS_Log["PuertoLogistica"]
            PS_Per["PuertoPersonas"]
            PS_Mas["PuertoMascotas"]
            PS_Alb["PuertoAlbergues"]
            PS_Bit["PuertoBitacora"]
        end
    end

    subgraph Dominio_Nucleo["DOMINIO PURO - NUCLEO INMUTABLE (Sin IO, Sin Procesos)"]
        subgraph Modelos["Modelos (Structs)"]
            M_Usuario["Usuario"]
            M_Zona["Zona, Sector, PuntoAtencion"]
            M_Log["Recurso, Movimiento, Necesidad"]
            M_Persona["Persona, Mensaje"]
            M_Mascota["Mascota"]
            M_Albergue["Albergue"]
        end

        subgraph Reglas["Reglas Puras y Algoritmos"]
            R_Val["Validaciones"]
            R_Est["Estados"]
            R_Perm["Permisos (RBAC MapSet)"]
            R_Asig["Asignacion (Atomica)"]
            R_Inv["Inventario (Transferencias)"]
            R_Jer["JerarquiaZona (Recursion Pura)"]
            R_Ord["Ordenamiento (Merge Sort)"]
            R_Sim["SimilitudMascotas (Jaccard Ponderado)"]
            R_Ocup["Ocupacion (Cupos y Aforo)"]
        end
    end

    subgraph Infraestructura_Salida["INFRAESTRUCTURA - PROCESOS OTP Y PERSISTENCIA"]
        subgraph Concurrencia_OTP["Procesos OTP y Mensajería"]
            G_Usr["GestorUsuarios\n(implementa PuertoUsuarios)"]
            G_Zon["GestorZonas\n(implementa PuertoZonas)"]
            G_Log["GestorLogistica\n(implementa PuertoLogistica)"]
            G_Per["GestorPersonas\n(implementa PuertoPersonas)"]
            G_Mas["GestorMascotas\n(implementa PuertoMascotas)"]
            Sup_Alb["SupervisorAlbergues\n(implementa PuertoAlbergues)"]
            P_Alb["Albergue\n(bucle receive puro)"]
            P_Bit["Bitacora\n(bucle receive puro)"]
            PubSub["Emergencias.PubSub"]
        end

        subgraph Persistencia_Archivos["Persistencia (.txt)"]
            Almacen["AlmacenArchivo (:file.consult)"]
        end
    end

    %% Relaciones Entrada -> Aplicación (Hacia adentro)
    Consola --> Analizador
    Analizador --> Despachador
    Despachador --> Casos_Uso
    Despachador --> Presentador

    Endpoint --> SesionCtrl
    Endpoint --> LiveViews
    SesionCtrl --> CU_Usr
    LiveViews --> Casos_Uso
    LiveViews --> NotifWeb
    NotifWeb -. difunde .-> PubSub
    PubSub -. notifica {:cambio, tema} .-> LiveViews

    %% Relaciones Aplicación -> Dominio y Puertos
    Casos_Uso --> Dominio_Nucleo
    Casos_Uso --> Puertos_Salida

    %% Implementación de Puertos
    G_Usr -. implementa .-> PS_Usr
    G_Zon -. implementa .-> PS_Zon
    G_Log -. implementa .-> PS_Log
    G_Per -. implementa .-> PS_Per
    G_Mas -. implementa .-> PS_Mas
    Sup_Alb -. implementa .-> PS_Alb
    P_Bit -. implementa .-> PS_Bit

    Concurrencia_OTP --> Almacen
